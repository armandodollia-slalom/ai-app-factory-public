{
  "$comment": "One table for both implementations of the declaration rules: architecture-policy/hooks/architecture/topology.py (the engine) and scripts/pipeline/lib/policy-topology.mjs (the factory guard). Each case is a `policy` section of .factory/app.json; `error` is a substring the refusal must contain, or absent when the declaration is accepted. `symlinks` lists the paths that are symbolic links in the case's checkout. Both implementations must return the same errors, word for word (scripts/factory/test/policy-library.test.mjs compares them).",
  "profile": {
    "projects": [
      {
        "name": "Catalog.API",
        "path": "src/Catalog.API",
        "type": "api",
        "service": "catalog",
        "layer": "presentation"
      },
      {
        "name": "Catalog.Tests",
        "path": "tests/Catalog.Tests",
        "type": "test",
        "layer": "test"
      }
    ],
    "services": [
      {
        "id": "catalog",
        "owns_datastores": [
          "catalogdb"
        ],
        "traits": [
          "owns_database",
          "exposes_http_api"
        ]
      }
    ],
    "shared_datastore_names": [
      "eventbus"
    ],
    "layer_dependencies": {
      "presentation": [
        "shared"
      ],
      "test": [
        "*"
      ],
      "shared": [
        "shared"
      ]
    }
  },
