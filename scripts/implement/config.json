{
  "implement": {
    "worktreeDir": "../{repo}-worktrees",
    "branchPrefix": "feat/",
    "delivery": "epic",
    "epic": {
      "branchPrefix": "epic/",
      "bugfixPrefix": "bugfix/",
      "grouping": "auto",
      "featureVerification": true,
      "prSplit": "epic",
      "maxTicketsPerGroup": null
    },
    "maxSubtasks": 4,
    "selfModeMaxFiles": 6,
    "maxConcurrentPairs": 2,
    "maxConcurrentAgents": 6,
    "maxTakeovers": 1,
    "maxAgentRunsPerStory": 20,
    "storyWallClockSec": 10800,
    "prepareCmd": null,
    "checks": [],
    "unitTests": {
      "cmd": null
    },
    "uiStory": {
      "titleTags": [
        "FE"
      ],
      "components": null
    },
    "pathHints": {
      "roots": [],
      "extensions": []
    },
    "requeue": {
      "envKeys": [],
      "outageCooldownSec": 3600
    },
    "ui": {
      "slotsCmd": [
        "node",
        "scripts/stack/slots.mjs"
      ],
      "teststackCmd": null,
      "leaseWaitSec": 300,
      "leaseRetrySec": 30,
      "stackTimeoutSec": 2400,
      "screenshotsDir": "artifacts/pairs",
      "renewEverySec": 1800,
      "artifactDirs": [
        "artifacts",
        "test-results",
        "playwright-report",
        "blob-report"
      ]
    },
    "decisions": {
      "smallDiffLoc": 60,
      "tinySubtaskLoc": 40,
      "tinySubtaskFiles": 3,
      "selfMaxTotalLoc": 150,
      "selfOverheadRunsPerSubtask": 2
    },
    "reviewGate": {
      "enabled": true,
      "timeoutSec": 900,
      "maxDiffChars": 120000,
      "systems": null,
      "ignore": [
        ".factory/metrics/**",
        ".factory/lessons/**",
        ".factory/state/**",
        ".factory/plans/**",
        ".factory/stack/scenarios/**",
        "**/graphify-out/**",
        "**/*.md"
      ],
      "floor": {
        "paths": [
          ".github/workflows/**",
          ".github/CODEOWNERS",
          "CODEOWNERS",
          "docs/CODEOWNERS",
          ".factory/config.json",
          ".factory/factory.json",
          ".factory/app.json",
          ".factory/policy/**",
          ".factory/agents/**",
          ".factory/lessons/**",
          ".factory/githooks/**",
          ".factory/bin/**",
          ".factory/stack/docker-compose.yaml"
        ],
        "categories": [
          "auth",
          "payments",
          "migration",
          "security"
        ],
        "minLevel": "High",
        "sharedMinLevel": "High"
      },
      "manySystems": 3,
      "confidence": {
        "agentWeight": 0.2,
        "implementRoundsAtMost": 2,
        "prCheckRoundsAtMost": 2,
        "highMinScore": 85
      },
      "approvals": {
        "default": 1,
        "Low": 1,
        "Medium": 1,
        "High": 1,
        "Severe": 1
      },
      "labels": {
        "approvals": "approvals:{n}",
        "needsHuman": "needs-human",
        "autoMerged": "auto-merged",
        "reopened": "reopened",
        "mergeFailed": "merge-failed"
      },
      "substantiveCommentChars": 20,
      "retro": {
        "minSample": 5,
        "raiseFindRate": 0.3,
        "raiseEscapeRate": 0.2,
        "lowerFindRate": 0.05
      },
      "enforced": true,
      "requiredChecks": null
    },
    "autoMerge": {
      "enabled": true,
      "identity": "gh-user",
      "method": "squash",
      "appTokenEnv": "REVIEW_GATE_APP_TOKEN",
      "hostAutoMerge": {
        "enabled": false
      }
    },
    "preOpen": {
      "branches": null,
      "afterOpen": "draft",
      "wipLabel": "work-in-progress"
    },
    "ci": {
      "maxFixRounds": 2,
      "wait": {
        "timeoutSec": 10800,
        "pollSec": 30,
        "settleSec": 60,
        "enabled": true
      },
      "parity": {
        "enabled": true
      }
    },
    "worker": {
      "maxRetries": 2,
      "retryDelaySec": 30
    },
    "maxOrchestratorRuns": 8,
    "maxBugFixReturns": 2,
    "maxParallel": null,
    "waitSec": {
      "prCheck": 14400,
      "prCheckStart": 300,
      "featureVerification": 14400
    },
    "pollSec": {
      "featureVerification": 5
    },
    "timeoutsSec": {
      "planner": 1800,
      "orchestrator": 3600,
      "pairImplementer": 1800,
      "pairVerifier": 600,
      "pairUiVerifier": 1200,
      "checks": 1800,
      "orchestratorFix": 5400,
      "epicPlanner": 1800
    },
    "maxCouncilRounds": 3,
    "councilPassScore": 9.5,
    "councilMembers": null,
    "orchestrator": {
      "model": null,
      "effort": null
    },
    "subtaskModels": null
  },
  "resources": {
    "reserveGb": 6,
    "worktreeGb": 3,
    "agentGb": 0.5,
    "lspServerGb": 0.8,
    "stackGb": 1.6,
    "dockerOverheadGb": 1,
    "waitPollSec": 15,
    "maxWaitSec": 1800
  }
}
