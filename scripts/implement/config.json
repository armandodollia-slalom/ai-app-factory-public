{
  "agent": {
    "models": {
      "implementer": null,
      "bugTriage": "opus"
    }
  },
  "modelClasses": {
    "small": "sonnet",
    "medium": "sonnet",
    "large": "opus"
  },
  "implement": {
    "worktreeDir": "../{repo}-worktrees",
    "branchPrefix": "feat/",
    "delivery": "epic",
    "epic": {
      "branchPrefix": "epic/",
      "bugfixPrefix": "bugfix/",
      "grouping": "auto",
      "planTimeoutSec": 1800,
      "featureVerification": true,
      "prCheck": "fix",
      "prCheckTimeoutSec": 14400
    },
    "prCheck": { "mode": "fix", "fixUntil": "major", "bugFixUntil": "minor", "fixLenses": [], "fixRounds": 3, "returnToImplementation": { "enabled": true, "maxReturns": 2, "minSeverity": "major" } },
    "maxBugsPerGroup": null,
    "parallel": "auto",
    "implementerTimeoutSec": 5400,
    "maxImplementerRuns": 8,
    "maxBugFixCycles": 2,
    "fvTimeoutSec": 14400,
    "fvPollSec": 5,
    "maxWorkerRetries": 2,
    "retryDelaySec": 30,
    "orchestrate": true,
    "maxSubtasks": 4,
    "selfModeMaxFiles": 6,
    "maxConcurrentPairs": 2,
    "maxConcurrentAgents": 6,
    "maxPairRounds": 3,
    "maxTakeovers": 1,
    "maxLargeSubtasks": 1,
    "maxAgentRunsPerStory": 20,
    "storyWallClockSec": 10800,
    "timeouts": {
      "plannerSec": 1800,
      "orchestratorSec": 3600,
      "pairImplementerSec": 1800,
      "codeVerifierSec": 600,
      "uiVerifierSec": 1200,
      "checkSec": 1800
    },
    "roles": {
      "orchestrator": {
        "cli": null,
        "modelClass": "large"
      },
      "pairImplementer": {
        "cli": null
      },
      "verifier": {
        "cli": null,
        "modelClass": "medium"
      },
      "uiVerifier": {
        "cli": null,
        "modelClass": "large"
      }
    },
    "prepareCmd": null,
    "checks": [],
    "unitTests": {
      "cmd": null
    },
    "uiStory": {
      "titleTags": [
        "FE"
      ],
      "components": null,
      "filePatterns": null
    },
    "pathHints": {
      "roots": [],
      "extensions": []
    },
    "requeue": {
      "envKeys": []
    },
    "ui": {
      "slotsCmd": [
        "node",
        "scripts/stack/slots.mjs"
      ],
      "teststackCmd": null,
      "leaseWaitSec": 300,
      "leaseRetrySec": 30,
      "stackTimeoutSec": 2400,
      "screenshotsDir": "artifacts/pairs",
      "renewEverySec": 1800
    },
    "lsp": {
      "enabled": true,
      "setupCmd": [
        "node",
        "scripts/lsp/setup.mjs"
      ],
      "lspdCmd": [
        "node",
        "scripts/lsp/lspd.mjs"
      ],
      "timeoutSec": 300
    },
    "decisions": {
      "smallDiffLoc": 60,
      "tinySubtaskLoc": 40,
      "tinySubtaskFiles": 3,
      "selfMaxTotalLoc": 150,
      "selfOverheadRunsPerSubtask": 2
    },
    "reviewGate": {
      "enabled": true,
      "timeoutSec": 900,
      "maxDiffChars": 120000,
      "systems": null,
      "ignore": [
        ".factory/metrics/**",
        ".factory/lessons/**",
        ".factory/state/**",
        ".factory/plans/**",
        ".factory/stack/scenarios/**",
        "**/graphify-out/**",
        "**/*.md"
      ],
      "floor": {
        "level": "High",
        "paths": [
          ".github/workflows/**",
          ".github/CODEOWNERS",
          "CODEOWNERS",
          "docs/CODEOWNERS",
          ".factory/config.json",
          ".factory/factory.json",
          ".factory/app.json",
          ".factory/policy/**",
          ".factory/agents/**",
          ".factory/lessons/**",
          ".factory/githooks/**",
          ".factory/bin/**",
          ".factory/stack/docker-compose.yaml"
        ],
        "categories": [
          "auth",
          "payments",
          "migration",
          "security"
        ]
      },
      "manySystems": 3,
      "sharedFloor": "High",
      "confidence": {
        "highMin": 85,
        "maxPairRounds": 2,
        "maxPrCheckRounds": 2,
        "agentWeight": 0.2
      },
      "approvals": {
        "default": 1,
        "Low": 1,
        "Medium": 1,
        "High": 1,
        "Severe": 1
      },
      "labels": {
        "approvals": "approvals:{n}",
        "needsHuman": "needs-human",
        "autoMerged": "auto-merged",
        "reopened": "reopened"
      },
      "substantiveCommentChars": 20,
      "retro": {
        "minSample": 5,
        "raiseFindRate": 0.3,
        "raiseEscapeRate": 0.2,
        "lowerFindRate": 0.05
      }
    },
    "autoMerge": {
      "native": false,
      "enabled": true,
      "identity": "gh-user",
      "method": "squash",
      "appTokenEnv": "REVIEW_GATE_APP_TOKEN"
    }
  },
  "resources": {
    "reserveGb": 6,
    "worktreeGb": 3,
    "agentGb": 0.5,
    "lspServerGb": 0.8,
    "stackGb": 1.6,
    "dockerOverheadGb": 1,
    "maxParallel": null,
    "waitPollSec": 15,
    "maxWaitSec": 1800
  }
}
