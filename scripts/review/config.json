{
  "architectureReview": {
    "maxCouncilRounds": 5,
    "councilPassScore": 9.5,
    "councilMembers": null,
    "orchestrator": {
      "model": null,
      "effort": null
    },
    "timeoutSec": 1200,
    "policy": {
      "enabled": true,
      "agent": "architecture-policy/agents/arch_review.py",
      "dir": ".factory/policy",
      "command": [
        "python",
        "{agent}",
        "review",
        "-"
      ],
      "lessonsCommand": [
        "python",
        "{agent}",
        "get_lessons",
        "-"
      ],
      "categories": {
        "security": "security",
        "data": "data",
        "resiliency": "resilience",
        "observability": "resilience",
        "error_handling": "correctness",
        "api": "fit",
        "architecture": "fit",
        "testing": "maintainability"
      },
      "maxLessons": 5,
      "requester": "implementer",
      "semantic": "auto",
      "timeoutSec": 600
    },
    "conventions": [
      "AGENTS.md",
      "CONTRIBUTING.md"
    ]
  }
}
