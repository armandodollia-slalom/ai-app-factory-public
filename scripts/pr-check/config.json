{
  "prCheck": {
    "maxRounds": 6,
    "debateTurns": 2,
    "timeoutSec": 1800,
    "fixTimeoutSec": 3600,
    "maxDiffChars": 400000,
    "hook": {
      "enabled": true,
      "requireTests": true,
      "waitForTestsMin": 1440,
      "pollSec": 20,
      "maxRuns": 3,
      "codeAgents": ["implementer"]
    },
    "exclude": [".factory/state", ".factory/metrics", "graphify-out"],
    "frontendPaths": null,
    "conventions": ["AGENTS.md", "CONTRIBUTING.md", ".editorconfig", ".markdownlint.json", ".factory/agents/implementer.md"],
    "video": {
      "extensions": [".webm", ".mp4", ".mov", ".mkv"],
      "defaultDirs": ["artifacts/e2e-videos", "test-results"],
      "maxFrames": 48,
      "maxTotalFrames": 60,
      "minFramesPerVideo": 6,
      "minIntervalSec": 1,
      "width": 1280
    },
    "models": {
      "claude": {
        "judge": "opus",
        "acceptance": "opus",
        "flow": "opus",
        "design": "opus",
        "video": "opus",
        "style": "sonnet",
        "defender": "opus",
        "fixer": "opus"
      },
      "copilot": {
        "judge": "claude-opus-5.5",
        "acceptance": "claude-opus-5.5",
        "flow": "claude-opus-5.5",
        "design": "claude-opus-5.5",
        "video": "claude-opus-5.5",
        "style": "claude-sonnet-5.5",
        "defender": "claude-sonnet-5.5",
        "fixer": "claude-opus-5.5"
      },
      "codex": {}
    }
  }
}
