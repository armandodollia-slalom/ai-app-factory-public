{
  "featureVerification": {
    "timeoutsSec": {
      "plan": 1800,
      "automation": 3600,
      "verifier": 900,
      "lessons": 1200,
      "tests": 1800
    },
    "slots": {
      "enabled": true
    },
    "enabled": true,
    "plansDir": ".factory/plans",
    "precheck": {
      "runTests": true,
      "fix": {
        ".md": [
          "node_modules/.bin/markdownlint",
          "--fix",
          "{files}"
        ]
      },
      "lint": {
        ".md": [
          "node_modules/.bin/markdownlint",
          "{files}"
        ]
      },
      "scenarioFile": "scenario.yaml",
      "validateScenario": null,
      "testRunners": null,
      "automationNotes": [],
      "lintExclude": [
        "**/node_modules/**",
        "**/bin/**",
        "**/obj/**",
        "**/dist/**",
        "**/wwwroot/lib/**",
        "**/*.min.js",
        "**/*.min.css",
        "**/*.bundle.js",
        ".factory/bin/**",
        "**/graphify-out/**"
      ],
      "requireStack": true,
      "requireUiEvidence": true,
      "runFullProjects": true,
      "fullProjectsEveryRound": false
    },
    "categories": {
      "plan": [
        "ac-not-covered",
        "missing-sad-path",
        "untestable-expectation",
        "invented-requirement",
        "vague-steps",
        "duplicate-case",
        "stale-vs-story",
        "other"
      ],
      "automation": [
        "case-not-covered",
        "tests-different-path",
        "wrong-assertion",
        "missing-assertion",
        "missing-setup",
        "over-mocked",
        "flaky-wait",
        "wrong-layer",
        "visual-mismatch",
        "other"
      ],
      "sadPathSubtypes": [
        "validation",
        "auth",
        "ownership",
        "not-found",
        "boundary",
        "concurrency",
        "conflict",
        "dependency-failure"
      ]
    },
    "evidence": {
      "manifest": "artifacts/e2e-videos/manifest.json"
    },
    "testExtensions": [],
    "slotWaitSec": 21600
  },
  "testPlan": {
    "maxCouncilRounds": 5,
    "councilPassScore": 9,
    "councilMembers": null,
    "orchestrator": {
      "model": null,
      "effort": null
    }
  },
  "testAutomation": {
    "maxCouncilRounds": 5,
    "councilPassScore": 9,
    "councilMembers": null,
    "orchestrator": {
      "model": null,
      "effort": null
    }
  }
}
