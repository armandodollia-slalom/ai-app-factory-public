{
  "tickets": {
    "dir": ".factory/state/board",
    "repo": null,
    "assetsBranch": "board-assets",
    "spikeEpic": {
      "key": "epic-research-spikes",
      "title": "Research spikes"
    }
  },
  "stateDir": ".factory/state",
  "metricsDir": ".factory/metrics",
  "agentsDir": "agents",
  "lessonsDir": ".factory/lessons",
  "baseRef": "origin/main",
  "bot": {
    "enabled": true,
    "namePattern": "dev-bot-{login}",
    "credentialsDir": "~/.config/ai-app-factory"
  },
  "storyGuard": {
    "enabled": true,
    "folders": [
      ".factory/state/board"
    ],
    "denyPaths": [],
    "denyHosts": [],
    "denyRepos": [],
    "installReadable": false,
    "networkOpen": false
  },
  "agent": {
    "supervisor": {
      "idleSec": 1800,
      "ceilingFactor": 10
    },
    "resultParseRetries": 1,
    "claude": {
      "promptCacheTtlSec": 300,
      "toolSearch": false
    }
  },
  "recovery": {
    "startingGraceSec": 120,
    "maxRetries": 3,
    "retryDelaySec": 60
  },
  "implExclude": [
    ".factory",
    "graphify-out"
  ],
  "factoryGuard": {
    "enabled": true,
    "protected": [
      ".factory/config.json",
      ".factory/factory.json",
      ".factory/manifest.json",
      ".factory/bin",
      ".factory/agents",
      ".factory/lessons",
      ".factory/policy",
      ".factory/githooks"
    ],
    "writers": [
      "retro"
    ]
  },
  "council": {
    "members": 1,
    "blockQuorum": "any",
    "onUnavailable": "fail",
    "lateGraceSec": 120,
    "explorationSeat": {
      "enabled": true
    },
    "shadowSeat": {
      "enabled": false
    },
    "scorecard": {
      "minSeats": 10,
      "weights": {
        "prCheckRuling": 1,
        "miss": 1,
        "ledToChange": 0.5,
        "lowWeightMiss": 0.25
      }
    },
    "intercom": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 0,
      "advertiseHost": null,
      "allowInsecureRemote": false,
      "maxTurnsPerMember": 2,
      "maxEscalations": 3,
      "onSplit": "orchestrator"
    }
  },
  "orchestrator": {
    "model": "opus",
    "effort": null
  },
  "retro": {
    "factory": {
      "enabled": true,
      "source": null,
      "allowedPaths": [
        "agents/",
        "docs/",
        "templates/",
        "skills/"
      ],
      "evidence": "summary"
    },
    "enabled": true,
    "allowedPaths": [
      ".factory/agents/",
      ".factory/policy/"
    ],
    "windowDays": 7,
    "intervalDays": 7,
    "lessons": {
      "storyThreshold": 3,
      "maxRules": 15,
      "retireAfterStories": 10,
      "revertMinRounds": 6,
      "examplesPerCategory": 5
    },
    "writerRules": {
      "minSamples": 10,
      "maxChangesPerRetro": 2
    }
  },
  "metrics": {
    "sink": {
      "type": "none"
    }
  },
  "experiment": {
    "testCmd": "npx playwright test -c playwright.teststack.config.ts {file}",
    "testTimeoutSec": 1800
  },
  "analysis": {
    "maxConcurrent": 2,
    "coverageTimeoutSec": 1800,
    "licenceReview": "default",
    "maxFixRounds": 2,
    "duplication": {
      "minTokens": 50
    },
    "complexity": {
      "maxCyclomatic": 15,
      "maxFunctionLines": 100
    }
  },
  "agentOverlayDir": ".factory/agents",
  "hooks": {
    "codeAgents": [
      "implementer"
    ]
  },
  "project": {
    "languages": [],
    "configSources": [],
    "toolPaths": [],
    "services": [],
    "frontendPaths": [],
    "testRoots": []
  }
}
