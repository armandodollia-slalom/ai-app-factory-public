{
  "maxLanguageServers": 6,
  "idleSec": 900,
  "callTimeoutSec": 60,
  "diagnosticsTimeoutSec": 20,
  "loadTimeoutSec": 900,
  "prepareTimeoutSec": 900,
  "check": [],
  "servers": [
    { "id": "bash", "extensions": [".sh", ".bash"], "languageIds": ["shellscript"], "command": "bash-language-server", "args": ["start"] },
    { "id": "json", "extensions": [".json", ".jsonc"], "languageIds": ["json", "jsonc"], "command": "vscode-json-language-server", "args": ["--stdio"], "hook": false },
    { "id": "yaml", "extensions": [".yml", ".yaml"], "languageIds": ["yaml"], "command": "yaml-language-server", "args": ["--stdio"], "hook": false }
  ]
}
