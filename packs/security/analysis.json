      "when": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml"
      ],
      "onChange": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml"
      ],
      "block": {
        "levels": [
          "error"
        ]
      },
      "lens": "correctness",
      "okExit": [
        0,
        1
      ],
      "version": {
        "cmd": [
          "{bin}",
          "-version"
        ],
        "match": "1.7.12"
      }
    },
    "jscpd": {
      "description": "duplicated code a change adds: clones with a copy on a changed line, over the whole repository so the other copy is found (evidence for the clean-code reviewer; its semantic mode stays off: it downloads a large model). A dependency of the factory",
      "licence": "MIT",
      "run": [
        "node",
        "{packs}/security/analysis/duplication.mjs",
        "--min-tokens",
        "{minTokens}",
        "--base",
        "{mergeBase}",
        "{files}"
      ],
      "parse": "lines",
      "scope": "changed-lines",
      "baseline": "lines",
      "lens": "clean-code",
      "missingPattern": "jscpd is not installed with the factory",
      "okExit": [
        0,
        1
      ]
    },
    "lizard": {
      "description": "functions a change adds or edits over the complexity or length limit (evidence for the clean-code reviewer). A Python tool: `lizard` on PATH (pip install lizard), or FACTORY_LIZARD",
      "licence": "MIT",
      "run": [
        "node",
        "{packs}/security/analysis/complexity.mjs",
        "--max-cyclomatic",
        "{maxCyclomatic}",
        "--max-lines",
        "{maxFunctionLines}",
        "--base",
        "{mergeBase}",
        "{files}"
      ],
      "parse": "lines",
      "scope": "changed-lines",
      "baseline": "lines",
      "lens": "clean-code",
      "missingPattern": "lizard is not installed",
      "okExit": [
        0,
        1
      ]
    },
    "psalm-taint": {
      "enabled": false,
      "description": "PHP taint analysis (declared, not exercised end to end)",
      "licence": "MIT",
      "when": [
        "composer.json"
      ],
      "run": [
        "vendor/bin/psalm",
        "--taint-analysis",
        "--no-progress",
        "--report={out}"
      ],
      "output": "{out}.sarif",
      "parse": "sarif",
      "scope": "repo",
      "baseline": "merge-base",
      "lens": "security",
      "block": {
        "levels": [
          "error"
        ]
      },
      "okExit": [
        0,
        1,
        2
      ]
    },
    "trivy-config": {
      "enabled": false,
      "description": "IaC and container configuration (optional; pin by digest yourself: Trivy's releases were compromised in March 2026, and its database and telemetry call out)",
      "licence": "Apache-2.0",
      "run": [
        "trivy",
        "config",
        "--format",
        "sarif",
        "--output",
        "{out}",
        "."
      ],
      "output": "{out}",
      "parse": "sarif",
      "scope": "repo",
      "baseline": "merge-base",
      "lens": "security"
    }
  },
  "optionalRules": {
    "$comment": "Rule sources a repository may add to analysis.tools.opengrep.rules (each off by default).",
    "opengrep": [
      {
        "id": "gitlab-sast-rules-lgpl",
        "enabled": false,
        "repo": "https://gitlab.com/gitlab-org/security-products/sast-rules.git",
        "commit": "83144bd2ec7d3200cda96347fa923f81c8ad8413",
        "include": [
          "rules/lgpl"
        ],
        "licence": "LGPL-3.0-only",
        "note": "Optional, off: LGPL-3.0 rule content needs an acceptLicence entry."
      },
      {
        "id": "0xdea-c",
        "enabled": false,
        "repo": "https://github.com/0xdea/semgrep-rules.git",
        "commit": "<pin a commit>",
        "exclude": [
          "rules/raptor-bad-words.yaml"
        ],
        "licence": "MIT",
        "note": "Optional C/C++ rules (MIT), without raptor-bad-words. Pin a commit to enable."
      }
    ]
  },
  "stages": {
    "pair": [
      "betterleaks",
      "opengrep",
      "osv-scanner",
      "zizmor",
      "actionlint",
      "jscpd",
      "lizard"
    ],
    "story": [
      "betterleaks",
      "opengrep",
      "osv-scanner",
      "zizmor",
      "actionlint",
      "jscpd",
      "lizard"
    ],
    "prCheck": [
      "betterleaks",
      "opengrep",
      "osv-scanner",
      "zizmor",
      "actionlint",
      "jscpd",
      "lizard"
    ],
    "featureVerification": [
      "betterleaks",
      "opengrep",
      "jscpd",
      "lizard"
    ]
  },
  "suppressions": [
    {
      "id": "secret-allow",
      "pattern": "betterleaks:allow|gitleaks:allow"
    },
    {
      "id": "nosemgrep",
      "pattern": "nosemgrep|nosem\\b|noopengrep"
    }
  ],
  "ci": [
    {
      "id": "secrets",
      "name": "Secret scan",
      "tools": [
        "betterleaks"
      ],
      "required": true
    },
    {
      "id": "dependencies",
      "name": "Dependency audit",
      "tools": [
        "osv-scanner"
      ],
      "required": true
    },
    {
      "id": "sast",
      "name": "Security patterns (SAST)",
      "tools": [
        "opengrep-interfile"
      ],
      "required": true,
      "timeoutSec": 2700
    },
    {
      "id": "workflows",
      "name": "Workflow lint",
      "tools": [
        "zizmor",
        "actionlint"
      ],
      "required": true
    }
  ]
}
