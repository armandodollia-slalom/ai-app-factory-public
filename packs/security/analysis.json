            "sha256": "51d2f918d7aad0afc1426bb4fbf56e32fc70c3ffd5ddb78e32e7d61e51c029a2",
            "bin": "opengrep"
          },
          "darwin-arm64": {
            "url": "https://github.com/opengrep/opengrep/releases/download/v2.0.0/opengrep_osx_arm64",
            "sha256": "b51b3d83f165a2e0934497b8f1b08abb1c3041ef20ef911c97e04cb39af1ad55",
            "bin": "opengrep"
          },
          "win32-x64": {
            "url": "https://github.com/opengrep/opengrep/releases/download/v2.0.0/opengrep_windows_x86.zip",
            "sha256": "899a17e2b15863367cfd15032c93cdf482fd4e7ec8719c69de46f4f38b227864",
            "bin": "opengrep.exe"
          }
        }
      },
      "run": [
        "{bin}",
        "scan",
        "--quiet",
        "{rules}",
        "--baseline-commit",
        "{mergeBase}",
        "--sarif-output={out}",
        "."
      ],
      "output": "{out}",
      "parse": "sarif",
      "scope": "repo",
      "baseline": "native",
      "block": {
        "levels": [
          "error"
        ]
      },
      "lens": "security",
      "okExit": [
        0,
        1
      ],
      "needsRules": true,
      "rules": [
        {
          "id": "gitlab-sast-rules",
          "repo": "https://gitlab.com/gitlab-org/security-products/sast-rules.git",
          "commit": "83144bd2ec7d3200cda96347fa923f81c8ad8413",
          "include": [
            "java",
            "scala",
            "python",
            "csharp",
            "javascript"
          ],
          "requireHeader": "License: MIT (c) GitLab Inc.",
          "licence": "MIT",
          "note": "Only files carrying the MIT header are loaded. rules/lgpl-cc (Commons Clause) and rules/gitlab (GitLab EE licence) are never included."
        },
        {
          "id": "gitlab-sast-rules-go-c",
          "repo": "https://gitlab.com/gitlab-org/security-products/sast-rules.git",
          "commit": "83144bd2ec7d3200cda96347fa923f81c8ad8413",
          "include": [
            "go",
            "c"
          ],
          "licence": "MIT",
          "licenceReview": "pending",
          "note": "Enabled by the owner's decision while a lawyer reviews provenance: these files carry no MIT header, and the repository LICENSE says third-party components keep their original licence."
        },
        {
          "id": "factory",
          "builtin": "opengrep",
          "include": [
            "typescript",
            "csharp"
          ],
          "licence": "MIT",
          "note": "The factory's own rules (packs/security/rules/opengrep)."
        }
      ],
      "validateRule": [
        "{bin}",
        "scan",
        "--config",
        "{rule}",
        "{empty}"
      ],
      "version": {
        "cmd": [
          "{bin}",
          "--version"
        ],
        "match": "2.0.0"
      },
      "timeoutSec": 900
    },
